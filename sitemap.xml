layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url><loc>{{ site.url }}/</loc><changefreq>weekly</changefreq><priority>1.0</priority></url>
  <url><loc>{{ site.url }}/renungan/</loc><changefreq>weekly</changefreq></url>
  {% for post in site.posts %}<url><loc>{{ site.url }}{{ post.url }}</loc><lastmod>{{ post.date | date_to_xmlschema }}</lastmod></url>
  {% endfor %}{% for page in site.pages %}{% if page.dir contains "/halaman/" %}<url><loc>{{ site.url }}{{ page.url }}</loc></url>
  {% endif %}{% endfor %}
</urlset>
